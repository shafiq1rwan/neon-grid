# CrazyGames build (`npm run build:crazygames`, `npm run package:crazygames`).
VITE_PORTAL=crazygames
VITE_SDK_URL=https://sdk.crazygames.com/crazygames-sdk-v3.js
# Ads stay off during Basic Launch (CrazyGames disables monetization there and
# forbids rewarded buttons that can't pay out). Set to true for Full Launch.
VITE_CG_ADS=false
