{
  "name": "neon-wasteland",
  "private": true,
  "version": "1.2.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && node scripts/package.mjs",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames",
    "package:crazygames": "npm run build:crazygames && node scripts/package.mjs crazygames"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
